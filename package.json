{
  "name": "banana-lab",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "바나나에서 탄수화물과 지질 관찰하기 — 웹 실험 시뮬레이터",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"experiments/*/tests/**/*.test.js\"",
    "check:art": "node scripts/check-art-direction.mjs",
    "fonts": "node scripts/build-fonts.mjs",
    "check:fonts": "node scripts/build-fonts.mjs --check",
    "check": "npm run test && npm run check:art && npm run check:fonts",
    "check:build": "node scripts/check-build.mjs",
    "shot": "node scripts/shot.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "vite": ">=6"
  }
}
